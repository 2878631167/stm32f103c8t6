{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake --build build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "rmdir /s /q build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "cmake --build build --target flash",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        },
        {
            "label": "Configure",
            "type": "shell",
            "command": "cmake -G Ninja -B build -DCMAKE_TOOLCHAIN_FILE=arm-none-eabi.cmake",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        }
    ]
}